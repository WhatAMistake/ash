# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI API Base URL (for custom endpoints)
OPENAI_API_BASE=https://api.openai.com/v1

# Admin Telegram ID (for /admin and /debug commands)
ADMIN_ID=111111111veryImportant

# Developer Telegram ID (for /dev_feedback)
DEV_ID=111111111

# Default language (en or ru)
DEFAULT_LANG=ru

# Telegram Business / Secretary Mode (isolated from regular Ash)
# false: may receive business updates, but never auto-replies
SECRETARY_ENABLED=false

# Hours to stay silent in a business chat after the owner writes there
SECRETARY_HUMAN_TAKEOVER_HOURS=12

# Visible answers never include separate reasoning fields or tagged thinking.
# Provider controls: off (default), low, medium, high, passthrough.
# Unknown providers receive no reasoning controls. A rejected parameter may be
# retried without controls; this cannot guarantee server-side thinking is off.
LLM_REASONING_POLICY=off

# SDK timeout per attempt, NOT an overall handler deadline. SDK retries can
# multiply latency (plus one adapter retry for an unsupported reasoning field).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Stored wire history (including RAG): compact oldest half on overflow.
# Also limited to 40 messages. Character budget, not a tokenizer/context limit.
LLM_HISTORY_MAX_CHARS=24000

# Optional writer-only Y/N intent classifier. Off by default; fail-closed.
# Adds a request on cache miss; 6s deadline, no retries, max 16000 input chars.
INTENT_GUARD_ENABLED=0
INTENT_GUARD_MODEL=deepseek-flash
# Inherit main endpoint/key when unset. If switching guard hostname, provide
# a dedicated key; never forward a main-provider credential to another host.
# INTENT_GUARD_API_BASE=https://api.cometapi.com/v1
# INTENT_GUARD_API_KEY=your_guard_key_here
# For OpenRouter set the appropriate provider-qualified model explicitly,
# e.g. deepseek/deepseek-v4.1-flash, and use https://openrouter.ai/api/v1.
# Prototype fail-open is intentionally disallowed in the application.
# INTENT_GUARD_FAIL_MODE=closed

# Optional display name for the account owner's secretary (no hardcoded owner).
# Keep empty for a generic introduction; the model handles grammatical cases.
SECRETARY_OWNER_NAME=
