# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI API Base URL (for custom endpoints)
OPENAI_API_BASE=https://api.openai.com/v1

# Admin Telegram ID (for /admin and /debug commands)
ADMIN_ID=111111111veryImportant

# Developer Telegram ID (for /dev_feedback)
DEV_ID=111111111

# Default language (en or ru)
DEFAULT_LANG=ru

# Telegram Business / Secretary Mode (isolated from regular Ash)
# false: may receive business updates, but never auto-replies
SECRETARY_ENABLED=false

# Hours to stay silent in a business chat after the owner writes there
SECRETARY_HUMAN_TAKEOVER_HOURS=12
